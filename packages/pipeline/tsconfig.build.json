{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": false,
    "emitDeclarationOnly": false,
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "rootDir": "src",
    "allowJs": false
  },
  "include": ["src/**/*"]
}
