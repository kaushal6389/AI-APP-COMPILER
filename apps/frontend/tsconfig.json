{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@ai-compiler/schemas": ["../../packages/schemas/src/index.ts"],
      "@ai-compiler/pipeline/*": ["../../packages/pipeline/*"],
      "@ai-compiler/validators/*": ["../../packages/validators/*"],
      "@ai-compiler/repair-engine/*": ["../../packages/repair-engine/*"],
      "@ai-compiler/runtime/*": ["../../packages/runtime/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
